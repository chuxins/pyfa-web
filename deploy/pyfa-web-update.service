[Unit]
Description=pyfa-web auto-update (git fetch + deps + restart + health check)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# 以 root 运行：Actions 与兜底定时器走的是同一条 root SSH/root 通道，脚本内部
# 用 runuser 把 git 降权到 pyfaweb 执行，所以仓库仍须由 pyfaweb 拥有、对 root 无碍。
# 这样省掉 deploy 用户、附加组与 /etc/sudoers.d 的 NOPASSWD 配置（旧机器那套）。
# 用 /bin/bash 显式调用，避免 Windows 检出/权限位丢失导致脚本无法执行。
User=root
ExecStart=/bin/bash /opt/pyfa-web/deploy/auto-update.sh
# 健康检查地址与 web.yml 的 port 不一致时在这里覆盖（默认 8091，见 README §9）
#Environment=PYFAWEB_HEALTH_URL=http://127.0.0.1:8091/api/meta
