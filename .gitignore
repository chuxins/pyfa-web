# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
env/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# ---- 本地部署数据（绝不提交）----
# EVE SSO 应用密钥（PYFA_WEB_SSO_*）：systemd EnvironmentFile
web.env
.env
.env.*
# 生产部署配置（模板见 web.yml.example）；compose.yml 以只读方式挂载此文件
web.yml
# 运行期数据：账号库 app.db、每用户 saveddata.db、设置、日志、会话签名密钥
webdata/
saveddata/
session.key
*.db
*.db-wal
*.db-shm
*.sqlite*
logs/
*.log
*.pid

# ---- 首启从 staticdata/ 生成的 SQLite 静态库（97 MB，可删）----
eve.db
eve.db-*

# ---- 构建 / 打包产物 ----
build/
dist/
dist_assets/
# 前端源码只有一个（web/frontend）；产物提交在 web/static，node_modules 一律不入库
node_modules/

# ---- 临时调试产物（CDP 脚本、接口快照、截图等）----
.agent_tmp/

# ---- 本机重启服务时的运行日志（调试用，不入库）----
log-*.out
log-*.err
_srv_*.log

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
*.swp
*~
